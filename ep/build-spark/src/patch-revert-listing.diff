-/**
- * Listing Manager to list leaf files using the statOffset. It's a stateful class, hold on to the
- * listing response which is used for future requests.
- */
-
-private[spark] class ConsolidatedListingManager(
-    hadoopConf: Configuration,
-    fileSystemProvider: (Path, Configuration) => FileSystem)
-    extends Logging {
-
-  // path which was lastRequested
-  private var lastRequested: Option[Path] = None
-
-  /**
-   * Manages the call to underneath fileSystem. Keep tracks of the response aka batch and current
-   * item in the batch which needs to be mapped to a partition.
-   */
-  private object BatchManager {
-    private var batchScore: Int = 1
-    private var currentBatch: Option[IndexedSeqView[FileStatus, Array[FileStatus]]] = None
-    private var currentIndex: Int = 0
-
-    private def updateBatch(
-        newBatch: Option[IndexedSeqView[FileStatus, Array[FileStatus]]]): Unit = {
-      currentBatch = newBatch
-      currentIndex = 0
-      batchScore = 1
-    }
-
-    def fetchNextPage(): Unit = {
-      // Use a guard clause to exit early if the resource is exhausted.
-      if (isResourceExhausted) return
-
-      currentBatch match {
-        case Some(page) if page.nonEmpty =>
-          val lastItem = page.last
-          val response = fetchFileStatusStartingFrom(lastItem.getPath)
-          // Remove duplicate first element from next page fetch
-          // Duplicate would be there as statOffset API includes request path as well.
-          // (given it is a file)
-          val nextPageContent =
-            if (response.headOption.map(_.getPath).contains(lastItem.getPath)) {
-              response.view.drop(1)
-            } else {
-              // Otherwise, create a view of the entire response.
-              response.view
-            }
-
-          updateBatch(Some(nextPageContent))
-
-        case Some(_) =>
-        // If the current page exists but is empty, there's nothing to do.
-
-        case None =>
-          // This case remains the same, as throwing an exception for an invalid
-          // state is the correct behavior.
-          throw new IllegalStateException(
-            "Cannot fetch next page when current page is not defined." +
-              " Control should not reach here.")
-      }
-    }
-
-    def fetchFreshBatch(path: Path): Unit = {
-      val resp = fetchFileStatusStartingFrom(path)
-      updateBatch(Some(resp.view))
-    }
-
-    def incrementBatchScore(): Unit = {
-      batchScore += 1;
-    }
-
-    def fetchBatchScore(): Int = {
-      batchScore
-    }
-
-    /**
-     * Determines if requested path can be served from the current response.
-     */
-    def canServeFromCurrentResponse(targetPath: Path): Boolean = {
-      isOrderedRequest(targetPath) && currentBatch.exists { responseArray =>
-        responseArray.nonEmpty && {
-          val lastPath = responseArray.last.getPath
-          lastPath.toString.compareTo(targetPath.toString) >= 0
-        }
-      }
-    }
-
-    def currentItem: Option[FileStatus] = {
-      currentBatch.flatMap(_.lift(currentIndex))
-    }
-
-    def incrementIndex(): Unit = {
-      currentIndex += 1
-    }
-
-    /**
-     * If current page fetched from gcs is empty i.e. we don't have any more file left.
-     */
-
-    def isResourceExhausted: Boolean = {
-      currentBatch.exists(_.isEmpty)
-    }
-
-    /**
-     * Makes a call to list API for a provided path.
-     */
-    private def fetchFileStatusStartingFrom(path: Path): Array[FileStatus] = {
-      val fs = fileSystemProvider(path, hadoopConf)
-      val listStatusMethod = ListingUtil.listMethodOptimized(fs)
-      listStatusMethod match {
-        case Success(method) =>
-          val result = ListingUtil.invokeMethodJavaReflection[Array[FileStatus]](method, fs, path)
-          result match {
-            case Success(res) =>
-              logDebug(
-                s"call to new list call successful. Got ${res.length} files for " +
-                  s"path: ${path}")
-              res
-            case Failure(res) =>
-              logWarning(
-                s"call to new list call failed for " +
-                  s"path: ${path}")
-              throw new IOException("issue while listing files", res)
-          }
-        case Failure(e) =>
-          throw new IOException("listStatusStartingFrom is not supported", e)
-      }
-    }
-  }
-
-  /*
-   * Requested path are in correct order if
-   * 1. they are lexicographically in correct order
-   * 2. not a sub-directory/partition of previously served path
-   *
-   * If A/ followed by A/B/, it is not in correct order
-   * Although they are in lexicographical order but because it's a sub directory of previous
-   * served path. We must have already listed all file in A/B. Current index in the page
-   * wouldn't be pointing to correct value to fulfill A/B.
-   * Hence a fresh request needs to be made for A/B.
-   */
-  private def isOrderedRequest(requested: Path): Boolean = {
-    lastRequested.forall { previousPath =>
-      val requestedDirStr = ListingUtil.toDir(requested).toString
-      val previousDirStr = ListingUtil.toDir(previousPath).toString
-
-      previousDirStr.compareTo(requestedDirStr) < 0 &&
-      !ListingUtil.isChildOf(previousPath, requested)
-    }
-  }
-
-  private def fetchNewBatchIfNeeded(path: Path): Unit = {
-    if (!BatchManager.canServeFromCurrentResponse(path)) {
-      // can't serve path from existing batch, fetch new
-      BatchManager.fetchFreshBatch(path)
-    } else {
-      // If request can be served from existing batch
-      // update the score for batch
-      BatchManager.incrementBatchScore()
-    }
-  }
-
-  private def updateServedPath(path: Path): Unit = {
-    lastRequested = Option.apply(path)
-  }
-
-  def listLeafFilesV2(path: Path): Array[FileStatus] = {
-    logInfo(s"Requesting listing leaf files for ${path}")
-    try {
-      val dirPath = ListingUtil.toDir(path)
-      fetchNewBatchIfNeeded(dirPath)
-      @tailrec
-      def collect(collected: List[FileStatus]): List[FileStatus] = {
-        BatchManager.currentItem match {
-          case Some(status) =>
-            val statusPath = status.getPath
-            if (ListingUtil.isChildOf(dirPath, statusPath)) {
-              // It's a child file, collect it and continue with the next item.
-              logDebug(s"Path ${statusPath} qualify as a leaf for ${dirPath} collect it.")
-              BatchManager.incrementIndex()
-              collect(status :: collected)
-            } else if (statusPath == path) {
-              // Path itself is a file. Collect it and stop.
-              BatchManager.incrementIndex()
-              logDebug(s"Path ${dirPath} is a file, not a directory. Collected it directly.")
-              status :: collected
-            } else {
-              val statusPath = status.getPath
-              if (statusPath.toString < dirPath.toString) {
-                // skip this status as it is pointing to status lower than the partition requested
-                // increment index so that it's skipped.
-                logDebug(
-                  s"Skipping ${statusPath} as it's lexicographically lesser than" +
-                    s" ${dirPath}")
-                BatchManager.incrementIndex()
-                collect(collected)
-              } else {
-                // We have hit a index which is higher then the one requested for
-                // and also not a child of it.
-                logDebug(
-                  s"Stopped collecting for ${dirPath}." +
-                    s"Encountered non-child ${statusPath}.")
-                collected
-              }
-            }
-
-          case None if !BatchManager.isResourceExhausted =>
-            // Current page is empty, but more pages might be available. Fetch and retry.
-            logInfo(s"Current batch exhausted for ${dirPath}. Fetching next page.")
-            BatchManager.fetchNextPage()
-            collect(collected)
-
-          case _ =>
-            // No current item and the resource is exhausted. We are done.
-            collected
-        }
-      }
-
-      // Initial call to the recursive function. The result is reversed because
-      // prepending (::) is more efficient for lists.
-      // we can reverse it again but that will require space.
-      // We can avoid reversing as listed leaf files can be in any order.
-      val collectedFiles: Seq[FileStatus] = collect(Nil)
-
-      // if there are no leaf files, it might be possible that it's a file
-      val listedFiles = if (collectedFiles.nonEmpty) {
-        collectedFiles
-      } else {
-        val fs = fileSystemProvider(path, hadoopConf)
-        try {
-          logDebug(s"Got nothing from directory listing of ${path}. Checking if it's a file.")
-          Seq(fs.getFileStatus(path))
-        } catch {
-          case e: FileNotFoundException =>
-            logDebug(s"Requested path ${path} is not even a file.")
-            Seq.empty[FileStatus]
-        }
-      }
-
-      logInfo(s"Finished listing for ${path}. Collected ${listedFiles.size} leaf files.")
-      listedFiles.toArray
-    } finally {
-      updateServedPath(path)
-    }
-  }
-
-  // made public only for unit testing
-
-  def canServeFromExistingBatch(path: Path): Boolean = {
-    !lastRequested.isDefined || BatchManager.canServeFromCurrentResponse(path)
-  }
-
-  /**
-   * Heuristic function to decide if using consolidated listing will actually be performant. We
-   * have use lis call base heuristic here i.e. number of calls required to list all partitions.
-   *
-   * Here we predict the number of calls required based on the current batch's score.
-   */
-  def shouldUseConsolidatedListing(
-      currentPath: Path,
-      remainingPath: Int,
-      parallelismThreshold: Int): Boolean = {
-    try {
-      canServeFromExistingBatch(currentPath) || {
-        val score = currentScore()
-        // Safety check to prevent division by zero.
-        // Ideally score should never be zero and always >=1
-        if (score <= 0) {
-          false
-        } else {
-          val estimatedListCalls = remainingPath / score
-          estimatedListCalls <= parallelismThreshold
-        }
-      }
-    } catch {
-      case e: Exception =>
-        logWarning(
-          s"An error occurred while checking for consolidated listing on path " +
-            s"'$currentPath'. Defaulting to false.",
-          e)
-        false
-    }
-  }
-
-  // made public only for unit testing purpose
-  def currentScore(): Int = {
-    BatchManager.fetchBatchScore()
-  }
-
-}
