-package org.apache.spark.util
-
-import java.net.URI
-
-import scala.util.Try
-
-import org.apache.hadoop.fs.{FileSystem, Path}
-
-private[spark] case object ListingUtil {
-
-  def listMethodOptimized(fs: FileSystem): Try[java.lang.reflect.Method] = {
-    Try {
-      val clazz = fs.getClass
-      clazz.getDeclaredMethod("listStatusStartingFrom", classOf[Path])
-    }
-  }
-
-  def invokeMethodJavaReflection[T](
-      method: java.lang.reflect.Method,
-      instance: Any,
-      args: AnyRef*): Try[T] = {
-    Try {
-      method.invoke(instance, args: _*).asInstanceOf[T]
-    }
-  }
-
-  /**
-   * Checks if a child Path is a direct or indirect descendant of a parent Path. This version is
-   * optimized to avoid object creation and correctly compares the full URI, including the scheme
-   * and authority.
-   *
-   * @param parent
-   *   The parent Path.
-   * @param child
-   *   The potential child Path.
-   * @return
-   *   True if the child is a descendant of the parent, false otherwise.
-   */
-  def isChildOf(parent: Path, child: Path): Boolean = {
-    // Get the canonical string representations of the full URIs
-    val parentStr = parent.toUri.toString
-    val childStr = child.toUri.toString
-
-    // A path cannot be a child of itself.
-    if (parentStr == childStr) {
-      return false
-    }
-
-    // Normalize the parent path string to ensure it ends with a slash
-    val normalizedParentStr = if (parentStr.endsWith("/")) {
-      parentStr
-    } else {
-      parentStr + "/"
-    }
-
-    // Perform a direct string comparison
-    childStr.startsWith(normalizedParentStr)
-  }
-
-  def toDir(path: Path): Path = {
-    val uriString = path.toUri.toString
-    if (uriString.endsWith("/")) {
-      path
-    } else {
-      new Path(URI.create(uriString + "/"))
-    }
-  }
-
-}
